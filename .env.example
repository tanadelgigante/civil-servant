# .env.example — ESEMPIO GENERICO (convenzione D21).
#
# Copiare questo file in `.env` (gitignorato) e sostituire i valori segnaposto
# con quelli reali della propria installazione. I valori reali li definisce
# l'installatore: il progetto consegna la forma e la documentazione, non i
# valori (R65, R101). Questo file e' coerente con il blocco `environment:` di
# `docker-compose.yaml` (R64).
#
# Ogni proprieta' e' documentata con: significato, default, comportamento se
# manca, comportamento con un valore errato (R101).

# PROPERTY1 — proprieta' d'esempio che illustra la forma di una variabile.
#   Significato : segnaposto; non ha effetto sul gateway in questa versione.
#   Default     : CHANGE_ME
#   Se manca    : il compose applica il default CHANGE_ME; il gateway parte.
#   Se errata   : nessun effetto in questa versione (segnaposto).
PROPERTY1=CHANGE_ME

# PROPERTY2 — seconda proprieta' d'esempio, come sopra.
#   Significato : segnaposto; non ha effetto sul gateway in questa versione.
#   Default     : CHANGE_ME
#   Se manca    : il compose applica il default CHANGE_ME; il gateway parte.
#   Se errata   : nessun effetto in questa versione (segnaposto).
PROPERTY2=CHANGE_ME
