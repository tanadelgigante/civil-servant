{
  "schemaVersion": 2,
  "name": "hello-world",
  "version": "1.0.0",
  "description": "Hello World example plugin",
  "runtime": {
    "type": "python",
    "version": "3.14"
  },
  "route": {
    "prefix": "/hello-world",
    "stripPrefix": 1
  },
  "backend": {
    "host": "127.0.0.1",
    "port": 9001,
    "portMode": "fixed"
  },
  "health": {
    "type": "process",
    "intervalSeconds": 10,
    "timeoutSeconds": 3,
    "startupTimeoutSeconds": 90
  },
  "setup": {
    "script": null
  },
  "start": {
    "command": "python3 -m http.server 9001 --bind 127.0.0.1"
  },
  "stop": {
    "timeoutSeconds": 20
  }
}
